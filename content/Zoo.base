filters:
  and:
    - file.hasTag("usecase")
views:
  - type: cards
    name: Card Wall
    order:
      - sector
      - verdict
      - confidence
      - timeline
      - file.basename
  - type: table
    name: Index
    order:
      - sector
      - verdict
      - confidence
      - timeline
      - scale
      - file.basename
    sort:
      - property: sector
        direction: DESC
